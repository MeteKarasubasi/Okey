EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_GAME_WS_URL=ws://localhost:8788

# WebSocket server only; never expose the service role key to Expo.
# These variables are used by the legacy Node server. Cloudflare uses .dev.vars.
GAME_WS_PORT=8787
GAME_WS_AUTH_REQUIRED=true
GAME_ALLOWED_ORIGINS=http://localhost:8081
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
